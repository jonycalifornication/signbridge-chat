# ── Обязательное ─────────────────────────────────────────────────────

# Клиентский ключ для gateway аватара: план жестов, поиск букв, языки.
# Расход считается по ключу, поэтому лучше свой, а не мастер-ключ виджета.
# Ключ должен быть авторизован и на бэкенде, и на сервисе глоссинга —
# иначе жесты не найдутся и в видео будут двигаться только губы.
AVATAR_API_KEY=

# ── Обычно менять не нужно ───────────────────────────────────────────

# Откуда берётся сборка аватара. Читается ТОЛЬКО при синхронизации зеркала,
# никогда во время рендера.
AVATAR_URL=https://widget.signbridge.kz

# Хранилище, откуда качаются VRMA (десятки файлов на видео) — напрямую,
# минуя продуктовый сервер аватара.
AVATAR_FILES_URL=http://94.131.83.85:8000

# Код языка. Бэкенд знает KSL, RSL, ASl. Старый kz_KSL не находит ничего.
RENDER_PLAN_LANGUAGE_ID=KSL

# Автообновление зеркала аватара, мс (минимум 60000). Пусто — только вручную
# через POST /admin/avatar/sync. Любое обновление сначала проверяется рендером.
AVATAR_SYNC_INTERVAL_MS=

# ── Тонкая настройка (по умолчанию не нужно) ─────────────────────────
# PORT=3003                        порт рендерера
# SELF_URL=http://localhost:3003   как puppeteer достаёт этот сервер
# RENDER_PLAN_API_URL=             переопределить адрес /translate/
# RENDER_PLAN_FETCH_TIMEOUT_MS=10000
# RENDER_ENCODER_MAX_QUEUE_SIZE=   глубина очереди энкодера (1..256)
# AVATAR_SMOKE_GLOSSES=алақан      фраза для проверочного рендера при синке

# Text→gloss здесь НЕ настраивается: глоссингом занимается gateway аватара,
# он сам ходит в t2g внутри /translate/. GLOSS_SERVICE_URL задаётся
# в окружении gateway (проект signBridge-avatar), а не тут.
