server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # SPA routing (чтобы перезагрузка страниц не давала 404)
  location / {
    try_files $uri $uri/ /index.html;
  }

  # --- Renderer endpoints (video generation + sessions) ---
  location /api/v1/video/ {
    proxy_pass ${RENDERER_URL};
    proxy_http_version 1.1;

    proxy_buffering off;
    proxy_cache off;
    proxy_set_header Connection '';

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_read_timeout 300;
    proxy_connect_timeout 300;
    proxy_send_timeout 300;
  }

  location /api/v1/sessions {
    proxy_pass ${RENDERER_URL};
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # No browser-facing proxy to the avatar or the storage backend: the video
  # generator UI only calls our own renderer. Translate/file traffic is issued
  # server-side (render plan) or inside the render page, which is served by the
  # renderer itself — so nothing avatar-related is reachable from the internet
  # through this vhost.

  # Админка (ключи + управление зеркалом аватара) наружу НЕ выставляется.
  # Доступ только с самого сервера: ssh -L 3003:127.0.0.1:3003 и открыть
  # http://localhost:3003/admin/keys

}