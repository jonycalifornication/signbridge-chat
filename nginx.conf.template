server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # SPA routing (чтобы перезагрузка страниц не давала 404)
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Proxy API to backend через переменную окружения BACKEND_URL
  # В docker-compose.yml ты задаёшь BACKEND_URL=...
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Proxy all v1 API requests (video and sessions) to the internal renderer service
  location /api/v1/ {
    proxy_pass ${RENDERER_URL};
    proxy_http_version 1.1;

    # Отключаем буферизацию для SSE (Server-Sent Events) потока
    proxy_buffering off;
    proxy_cache off;
    proxy_set_header Connection '';

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    
    # Increase timeouts for long-running video generation tasks
    proxy_read_timeout 300;
    proxy_connect_timeout 300;
    proxy_send_timeout 300;
  }

}